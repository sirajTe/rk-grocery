# Copy to backend/.env and change before deploying
MONGODB_URL=mongodb://localhost:27017
# MongoDB Atlas example: MONGODB_URL=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=rketech
ADMIN_EMAIL=rketech9896@gmail.com
ADMIN_PASSWORD=change-me
# Long random string, e.g.  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
TOKEN_HOURS=12
# Frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,https://www.rketech.store
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
SEED_ON_STARTUP=true
